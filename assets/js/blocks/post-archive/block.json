{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "solaire/post-archive",
  "title": "Solaire Post Archive",
  "category": "design",
  "icon": "grid-view",
  "description": "Displays a grid of posts or custom post types with Load More support.",
  "editorScript": "file:./build/index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "supports": { "html": false },
  "attributes": {
    "sectionLabel": { "type": "string", "default": "All Blogs" },
    "postType": { "type": "string", "default": "posts" },
    "postsPerPage": { "type": "number", "default": 4 },
    "showLoadMore": { "type": "boolean", "default": true },
    "columns": { "type": "number", "default": 2 }
  }
}
